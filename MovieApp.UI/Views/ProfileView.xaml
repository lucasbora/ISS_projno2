<!-- ProfileView: User profile with points and earned badges -->
<UserControl
    x:Class="MovieApp.UI.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MovieApp.Core.Models">

    <Grid Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Center">

                <!-- Header -->
                <TextBlock Text="👤 My Profile"
                           FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

                <!-- Points Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="16" Padding="28" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Points -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="🏆 Total Points" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalPoints, Mode=OneWay}"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </StackPanel>

                        <!-- Weekly Score -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="📅 Weekly Score" FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.WeeklyScore, Mode=OneWay}"
                                       FontSize="48" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Badges Section -->
                <TextBlock Text="🎖️ Earned Badges" FontSize="22" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- No badges message -->
                <Border Visibility="{x:Bind ViewModel.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverter}}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="32" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎗️" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="No badges earned yet"
                                   FontSize="16" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Keep reviewing movies to unlock achievements!"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Badge Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Badges}"
                              Visibility="{x:Bind ViewModel.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Badge">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="12" Padding="20" Margin="0,0,12,12"
                                    MinWidth="180">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🏅" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                    <TextBlock FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="Criteria: "/>
                                        <Run Text="{x:Bind CriteriaValue}" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- All Available Badges Guide -->
                <TextBlock Text="📋 All Badges" FontSize="22" FontWeight="SemiBold"
                           Margin="0,20,0,12"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 The Snob" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Write 10 extra reviews"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 Why so serious?" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Fully complete 50 extra reviews"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 The Joker" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="70%+ of your reviews are comedies"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 The Godfather I" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Write 100 total reviews"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 The Godfather II" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Write 200 total reviews"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🏅 The Godfather III" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Write 300 total reviews"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
